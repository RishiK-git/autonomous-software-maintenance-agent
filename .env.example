# Copy to .env and fill in real values (or export these in your shell).
# .env is git-ignored; never commit real secrets.

# Anthropic Developer API key (metered billing). Fund a small, fixed amount
# to cap cost while developing — see docs/roadmap.md's cost-control notes.
ANTHROPIC_API_KEY=

# GitHub personal access token with permission to create issues on the
# target repo(s).
GITHUB_TOKEN=

# Optional overrides (defaults shown):
# MAINTENANCE_AGENT_MODEL=claude-sonnet-5
# MAINTENANCE_AGENT_MAX_TURNS=20
# MAINTENANCE_AGENT_MAX_COST_USD=1.0
